MAGICTOWN_DATABASE_URL=postgres://localhost:5432/magictown
MAGICTOWN_HOST=127.0.0.1
MAGICTOWN_PORT=4183
MAGICTOWN_PUBLIC_BASE_URL=http://127.0.0.1:4183

# hunyuan-image: paired Hunyuan day-off/day-on production; qwen-image: legacy
# automatic generation; codex-manual: prompt export plus uploaded PNG artifact.
MAGICTOWN_ASSET_PROVIDER=hunyuan-image
HUNYUAN_IMAGE_API_KEY=
HUNYUAN_IMAGE_MODEL=hy-image-v3.0
HUNYUAN_IMAGE_RESOLUTION=1024:1024
HUNYUAN_IMAGE_POLL_MS=5000
HUNYUAN_IMAGE_TIMEOUT_MS=600000
HUNYUAN_MINIMUM_PAIR_IOU=0.97
HUNYUAN_MINIMUM_LIGHT_PIXELS=40
HUNYUAN_MAXIMUM_ANCHOR_ERROR=0.045
HUNYUAN_MAXIMUM_ENVELOPE_OVERFLOW=0.12
# Set to 1 only for diagnostics. Normalization is a uniform scale + translation;
# it never stretches building height independently.
HUNYUAN_SKIP_ANCHOR_NORMALIZATION=0
HUNYUAN_PYTHON_PATH=.venv/bin/python
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_SIZE=1024*1024

MAGICTOWN_CAPABILITY_TTL_MINUTES=30
MAGICTOWN_CREDENTIAL_TTL_DAYS=90
