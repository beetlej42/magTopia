MAGICTOWN_DATABASE_URL=postgres://localhost:5432/magictown
MAGICTOWN_HOST=127.0.0.1
MAGICTOWN_PORT=4183
MAGICTOWN_PUBLIC_BASE_URL=http://127.0.0.1:4183

# qwen-image: automated Qwen-Image generation; codex-manual: job exports a
# prompt and waits for POST /api/v1/asset-jobs/{job_id}/artifacts.
MAGICTOWN_ASSET_PROVIDER=qwen-image
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_SIZE=1024*1024

MAGICTOWN_CAPABILITY_TTL_MINUTES=30
MAGICTOWN_CREDENTIAL_TTL_DAYS=90
